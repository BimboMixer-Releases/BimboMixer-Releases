rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utenti: leggibili da tutti gli autenticati, scrivibili da tutti gli autenticati
    // (senza Cloud Functions/Custom Claims non possiamo verificare il ruolo admin lato server)
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Access logs: APPEND-ONLY — creazione permessa, modifica e cancellazione vietate
    match /access_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Audit log: APPEND-ONLY — nessuno può modificare o cancellare i log di sicurezza
    match /audit_log/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Login attempts: gestione rate limiting
    match /login_attempts/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // Dati operativi: accessibili a tutti gli utenti autenticati
    match /customers/{doc} {
      allow read, write: if request.auth != null;
    }
    match /categories/{doc} {
      allow read, write: if request.auth != null;
    }
    match /service_types/{doc} {
      allow read, write: if request.auth != null;
    }
    match /payments/{doc} {
      allow read, write: if request.auth != null;
    }
    match /invoices/{doc} {
      allow read, write: if request.auth != null;
    }
    match /deadlines/{doc} {
      allow read, write: if request.auth != null;
    }
    match /calendar_events/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
